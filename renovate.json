{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["at 09:00 on sunday"],
  "enabledManagers": ["pre-commit", "custom.regex"],
  "packageRules": [
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks",
      "commitMessagePrefix": "chore(ci):"
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "dockerfile tool versions",
      "commitMessagePrefix": "fix(docker):"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG HURL_VERSION=(?<currentValue>[\\d.]+)\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Orange-OpenSource/hurl"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG K6_VERSION=(?<currentValue>v[\\d.]+)\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "grafana/k6"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG HELM_VERSION=(?<currentValue>v[\\d.]+)\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "helm/helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG KUBECTL_VERSION=(?<currentValue>v[\\d.]+)\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG GHZ_VERSION=(?<currentValue>v[\\d.]+)\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "bojand/ghz"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG GRPC_HEALTH_PROBE_VERSION=(?<currentValue>v[\\d.]+)\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "grpc-ecosystem/grpc-health-probe"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["python = \"(?<currentValue>[\\d.]+)\"\\n"],
      "datasourceTemplate": "python-version",
      "depNameTemplate": "python"
    }
  ]
}
